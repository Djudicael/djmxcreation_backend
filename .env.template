# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portfolio

# ── Object storage (RustFS / S3-compatible) ─────────────────────────────────
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=portfolio

# ── API security ────────────────────────────────────────────────────────────
# OpenID Connect WASI Hub (required; the backend never disables authentication)
OIDC_ISSUER=http://localhost:3000/realms/portfolio
OIDC_AUDIENCE=portfolio-api
OIDC_ADMIN_CLIENT_ID=portfolio
OIDC_ADMIN_ROLE=admin
# Browser origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3008

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8081

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
